# Optional backend services. Never commit real credentials.
# Email OTP: both values are required. EMAIL_FROM must be a sender verified with Resend.
# Example format: Niqaha <otp@your-verified-domain.com>
RESEND_API_KEY=
EMAIL_FROM=

# International SMS: all values are required. Use an approved Twilio sender in E.164 format.
# Blank values disable international SMS OTP; existing Bangladesh SMS settings remain separate.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google Gemini: backend only. An empty key disables the AI helper.
# GOOGLE_GENERATIVE_AI_API_KEY is also supported as an alternative key name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional comma-separated frontend origins:
# FRONTEND_URL=https://niqaha.com
# Optional Express trusted proxy addresses/ranges:
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal
