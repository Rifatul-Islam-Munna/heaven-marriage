# Optional backend services. Never commit real credentials.
# Email OTP: both values are required. EMAIL_FROM must be a sender verified with Resend.
# Example format: Niqaha <otp@your-verified-domain.com>
RESEND_API_KEY=
EMAIL_FROM=

# International SMS: all values are required. Use an approved Twilio sender in E.164 format.
# Blank values disable international SMS OTP; existing Bangladesh SMS settings remain separate.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google Gemini: backend only. An empty key disables the AI helper.
# GOOGLE_GENERATIVE_AI_API_KEY is also supported as an alternative key name.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ZiniPay hosted checkout. The published sandbox key is for local testing only.
# Set a live merchant key in the production environment; never commit live credentials.
ZINIPAY_API_KEY=sandbox_test_8f4c9a2e7b31
ZINIPAY_API_BASE_URL=https://api.zinipay.com

# ZiniPay needs public HTTPS URLs; the redirect domain must match your active ZiniPay brand website.
# Use a public staging domain or HTTPS tunnel for local end-to-end testing.
# ZINIPAY_FRONTEND_URL=https://staging.your-brand-domain.com
# ZINIPAY_BACKEND_URL=https://staging-api.your-brand-domain.com
# If omitted, ZiniPay falls back to FRONTEND_URL and BACKEND_URL.
# FRONTEND_URL=https://niqaha.com
# BACKEND_URL=https://api.niqaha.com
# Optional Express trusted proxy addresses/ranges:
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal
