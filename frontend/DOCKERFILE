# Debian/glibc matches Next.js' native Linux SWC binary. Alpine's musl
# compatibility layer can make Turbopack fall back to unsupported WASM.
FROM node:22-bookworm-slim AS base
WORKDIR /app

# ===== Build (includes dev and platform-specific optional dependencies) =====
FROM base AS builder
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --include=optional

# Fail immediately if the native Linux compiler cannot load.
RUN node -e "require('@next/swc-linux-x64-gnu'); console.log('Native Linux SWC loaded')"

# Local Windows node_modules and build artifacts are excluded by .dockerignore.
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1

# Public client variables must be passed at image build time (not runtime).
ARG NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID}

# Easypanel forwards service environment values as Docker build arguments.
# Server Actions use this secret at BUILD time. Keep the same value on all
# deployments; don't echo its value into build logs or copy it to the runner.
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
ARG GIT_SHA
# Persist the same AES key across builds, but give each new deployment its
# own ID. Without an injected commit SHA, generate an ID once at build time.
RUN node -e "const k=process.env.NEXT_SERVER_ACTIONS_ENCRYPTION_KEY; if (!k || ![16,24,32].includes(Buffer.from(k,'base64').length)) { console.error('Provide a valid NEXT_SERVER_ACTIONS_ENCRYPTION_KEY Docker BUILD ARG (not runtime-only)'); process.exit(1); }" \
    && if [ -n "$GIT_SHA" ]; then \
         DEPLOYMENT_VERSION="$GIT_SHA" npm run build; \
       else \
         DEPLOYMENT_VERSION="$(node -e 'process.stdout.write(require("node:crypto").randomUUID())')" npm run build; \
       fi

# ===== Minimal production runner =====
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=80
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs --create-home nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 80
CMD ["node", "server.js"]
